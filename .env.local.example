# Copy this file to .env.local for local testing, and enter these same
# three values into Vercel's Project Settings > Environment Variables
# for the live site. See SETUP.md for exactly where to find each value.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional — Maker Studio Paint / Postcard image generation (DALL·E / gpt-image).
# Text AI modes (Teach the Buddy, What if) use ANTHROPIC_API_KEY above.
# Without OPENAI_API_KEY, kids still finish via library pick or draw.
OPENAI_API_KEY=
